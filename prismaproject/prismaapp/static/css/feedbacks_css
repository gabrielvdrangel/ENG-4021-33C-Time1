body { font-family: Arial, sans-serif; background: #f4f4f8; margin: 0; }
.container { max-width: 720px; margin: 0 auto; padding: 24px 16px; }
h1 { margin-bottom: 4px; }
.subtitulo { color: #666; margin-bottom: 24px; }
.card { background: #fff; border-radius: 12px; padding: 16px;
        margin-bottom: 16px; box-shadow: 0 2px 6px rgba(0,0,0,.08); }
.card-topo { display: flex; justify-content: space-between; }
.data { color: #888; font-size: 14px; }
.estrelas { color: #f5a623; font-size: 20px; margin: 8px 0; }
.vazio { text-align: center; color: #888; }
